# Copy to .dev.vars for `wrangler dev`. Leave RESEND_API_KEY out locally: sign-in links print in the wrangler console.
BETTER_AUTH_SECRET=any-long-random-string
# Sign-in links go back to Vite locally; wrangler.jsonc has the production URL.
BETTER_AUTH_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Owners of the admin page (#/admin), comma-separated. In production: npx wrangler secret put ADMIN_EMAILS
# ADMIN_EMAILS=you@example.com
