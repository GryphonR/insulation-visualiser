{
  "name": "insulation-visualiser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "cf:db": "wrangler d1 migrations apply insuliser --local",
    "cf:dev": "wrangler dev --port 8787",
    "dev:cloud": "vite --mode cloud",
    "cf:build": "tsc --noEmit && tsc --noEmit -p worker && vite build --mode cloud && node scripts/prerender.mjs cloud",
    "cf:deploy": "npm run cf:build && wrangler d1 migrations apply insuliser --remote && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.164.0"
  }
}
